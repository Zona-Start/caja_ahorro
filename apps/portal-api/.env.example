# =============================================================================
# Portal del Asociado · portal-api
# Copia este archivo a `.env` y ajusta los valores.
# =============================================================================

# Server
HOST=localhost
PORT=3001
NODE_ENV=development
ALLOW_CORS_URL=http://localhost:4321
PLATFORM_DOMAIN=zonastart.local

# Base de datos (rol `portal_app` de mínimo privilegio).
# El search_path debe incluir el esquema `portal`.
PORTAL_DATABASE_URL="postgresql://portal_app:changeme@localhost:5432/caja_ahorro?options=-c%20search_path=portal,savings,core,tenant,treasury,inventory,public"

# SSL de la conexión a BD: auto | true | false
#   auto  -> TLS cuando NODE_ENV=production, sin TLS en dev
#   true  -> forzar TLS (Postgres administrado)
#   false -> sin TLS (Postgres local sin TLS)
PORTAL_DB_SSL=auto

# JWT del portal (realm propio; >=32 caracteres; sin fallback).
PORTAL_JWT_SECRET=
PORTAL_JWT_REFRESH_SECRET=
PORTAL_JWT_EXPIRY=15m
PORTAL_JWT_REFRESH_EXPIRY=7d
PORTAL_BCRYPT_SALT_ROUNDS=10
PORTAL_MAX_LOGIN_ATTEMPTS=5
PORTAL_LOCK_MINUTES=15

# Correo (OTP) vía Resend
RESEND_API_KEY=
RESEND_FROM="Portal Zona Start <no-reply@zonastart.local>"
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Aprovisionamiento automático (cron que crea cuentas de asociados nuevos).
# Activo por defecto (true). Diario a las 06:00 en la zona indicada.
PORTAL_PROVISIONING_ENABLED=true
PORTAL_PROVISIONING_CRON=0 6 * * *
PORTAL_PROVISIONING_TZ=America/Caracas
# Ejecutar una pasada al arrancar (tras reinicios)
PORTAL_PROVISIONING_RUN_ON_START=true
