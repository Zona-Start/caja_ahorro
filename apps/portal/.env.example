# =============================================================================
# Portal del Asociado · apps/portal (Astro)
# Copia este archivo a `.env` y ajusta los valores.
# =============================================================================

# URL base de portal-api (server-only).
# En producción: URL del servidor del backend, p. ej. https://api-portal.zonastart.com/api/portal
PORTAL_API_URL=http://localhost:3001/api/portal

# Dev/localhost: host de tenant a usar cuando el host real no resuelve
# (opcional). En producción se resuelve por el host real.
# PORTAL_DEFAULT_TENANT_HOST=caja.caprebdt.local

# Pantalla de mantenimiento: true => por defecto se muestra /maintenance
MAINTENANCE_MODE=false
