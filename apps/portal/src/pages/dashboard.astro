---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import EmptyState from '../components/EmptyState.astro';
import DetailModal from '../components/DetailModal';
import { fetchAuthed } from '../lib/auth';
import { clearSession } from '../lib/session';
import { dateFmt, money, text } from '../lib/format';
import {
  CREDIT_STATUS_TYPES,
  LOAN_STATUS_TYPES,
  MOVEMENT_STATUS_TYPES,
  MOVEMENT_TYPES,
  WITHDRAWAL_STATUS_TYPES,
  label,
  statusTone,
} from '../lib/labels';

interface Statement {
  cedula: string;
  fullname: string;
  status: string;
  accountNumber: string | null;
  bankName: string | null;
  totalHaberes: string;
  paymentCapacity: string;
  disponibility: string;
  haberesContribution: string;
  haberesVoluntary: string;
  haberesEmployer: string;
  surpluses: string;
  isPayrollCredit: boolean;
}
type Row = Record<string, unknown>;
interface Paginated {
  data: Row[];
  meta: {
    page: number;
    limit: number;
    totalCount: number;
    totalPages: number;
    hasNextPage: boolean;
    hasPreviousPage: boolean;
  };
}

const tabs = [
  { value: 'haberes', label: 'Haberes' },
  { value: 'retiros', label: 'Retiros' },
  { value: 'prestamos', label: 'Préstamos' },
  { value: 'creditos', label: 'Créditos' },
  { value: 'historial', label: 'Historial' },
  { value: 'excesos', label: 'Excesos / Movimientos' },
] as const;

const EXCESOS_TYPES = [
  { value: 'SAVING_WITHDRAWAL_REVERSAL_CREDIT', label: 'Reversión de retiro' },
  { value: 'LOAN_PAYMENT_REVERSAL_CREDIT', label: 'Reversión pago préstamo' },
  { value: 'CREDIT_PAYMENT_REVERSAL_CREDIT', label: 'Reversión pago crédito' },
];

const columnsByTab: Record<string, { label: string; render: (r: Row) => string; badge?: boolean }[]> = {
  haberes: [
    { label: 'Fecha', render: (r) => dateFmt(r.fecha) },
    { label: 'Tipo', render: (r) => label(MOVEMENT_TYPES, r.tipo) },
    { label: 'Concepto', render: (r) => text(r.concepto) },
    { label: 'Monto', render: (r) => money(r.monto) },
  ],
  retiros: [
    { label: 'Fecha', render: (r) => dateFmt(r.withdrawalDate) },
    { label: 'Tipo', render: (r) => text(r.description) },
    { label: 'Monto', render: (r) => money(r.amount) },
    { label: 'Estado', render: (r) => label(WITHDRAWAL_STATUS_TYPES, r.status), badge: true },
    { label: 'Referencia', render: (r) => text(r.referenceCode) },
  ],
  prestamos: [
    { label: 'Fecha', render: (r) => dateFmt(r.requestDate) },
    { label: 'Tipo', render: (r) => text(r.loanType) },
    { label: 'Monto', render: (r) => money(r.loanAmount) },
    { label: 'Saldo', render: (r) => money(r.outstandingBalance) },
    { label: 'Cuota', render: (r) => money(r.installmentAmount) },
    { label: 'Estado', render: (r) => label(LOAN_STATUS_TYPES, r.status), badge: true },
  ],
  creditos: [
    { label: 'Fecha', render: (r) => dateFmt(r.requestDate) },
    { label: 'Tipo', render: (r) => text(r.creditType) },
    { label: 'Monto', render: (r) => money(r.creditAmount) },
    { label: 'Saldo', render: (r) => money(r.outstandingBalance) },
    { label: 'Cuota', render: (r) => money(r.installmentAmount) },
    { label: 'Estado', render: (r) => label(CREDIT_STATUS_TYPES, r.status), badge: true },
  ],
  historial: [
    { label: 'Fecha', render: (r) => dateFmt(r.fecha) },
    { label: 'Tipo', render: (r) => label(MOVEMENT_TYPES, r.tipo) },
    { label: 'Descripción', render: (r) => text(r.descripcion) },
    { label: 'Referencia', render: (r) => text(r.numeroReferencia) },
    { label: 'Monto', render: (r) => money(r.monto) },
    { label: 'Estado', render: (r) => label(MOVEMENT_STATUS_TYPES, r.status), badge: true },
  ],
  excesos: [
    { label: 'Fecha', render: (r) => dateFmt(r.fecha) },
    { label: 'Tipo', render: (r) => label(MOVEMENT_TYPES, r.tipo) },
    { label: 'Descripción', render: (r) => text(r.descripcion) },
    { label: 'Referencia', render: (r) => text(r.numeroReferencia) },
    { label: 'Monto', render: (r) => money(r.monto) },
  ],
};

const detailKind: Record<string, string> = {
  prestamos: 'prestamo',
  creditos: 'credito',
  retiros: 'retiro',
};

const stRes = await fetchAuthed(Astro.cookies, '/me/statement');
if (stRes.status === 401 || !stRes.data) {
  clearSession(Astro.cookies);
  return Astro.redirect('/login');
}
const statement = (stRes.data as { data: Statement }).data;

const rawTab = Astro.url.searchParams.get('tab') ?? 'haberes';
const active = (tabs.some((t) => t.value === rawTab) ? rawTab : 'haberes') as string;
const rawPage = parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(rawPage) && rawPage > 0 ? rawPage : 1;
const LIMIT_OPTIONS = [10, 20, 30, 50];
const rawLimit = parseInt(Astro.url.searchParams.get('limit') ?? '10', 10);
const limit = LIMIT_OPTIONS.includes(rawLimit) ? rawLimit : 10;

let rows: Row[] = [];
let meta = {
  page,
  limit,
  totalCount: 0,
  totalPages: 0,
  hasNextPage: false,
  hasPreviousPage: false,
};
let counts: Record<string, number> = {};
let selectedType = EXCESOS_TYPES[0]!.value;

if (active === 'excesos') {
  const sumRes = await fetchAuthed(Astro.cookies, '/me/excesos');
  counts = ((sumRes.data as { data: Record<string, number> } | null)?.data) ?? {};

  const rawMt = Astro.url.searchParams.get('mt');
  selectedType =
    rawMt && EXCESOS_TYPES.some((t) => t.value === rawMt)
      ? rawMt
      : (EXCESOS_TYPES.find((t) => (counts[t.value] ?? 0) > 0)?.value ??
        EXCESOS_TYPES[0]!.value);

  const movRes = await fetchAuthed(
    Astro.cookies,
    `/me/movimientos?movementType=${selectedType}&page=${page}&limit=${limit}`,
  );
  const payload = movRes.data as Paginated | null;
  rows = payload?.data ?? [];
  if (payload?.meta) meta = payload.meta;
} else {
  const dataRes = await fetchAuthed(
    Astro.cookies,
    `/me/${active}?page=${page}&limit=${limit}`,
  );
  const payload = dataRes.data as Paginated | null;
  rows = payload?.data ?? [];
  if (payload?.meta) meta = payload.meta;
}

const columns = columnsByTab[active]!;
const detailKindForTab = detailKind[active];

const link = (tab: string, p = 1) =>
  `/dashboard?tab=${tab}&page=${p}&limit=${limit}`;
const excesosLink = (mt: string, p = 1) =>
  `/dashboard?tab=excesos&mt=${mt}&page=${p}&limit=${limit}`;

const emptyLabels: Record<string, string> = {
  haberes: 'haberes',
  retiros: 'retiros',
  prestamos: 'préstamos',
  creditos: 'créditos',
  historial: 'movimientos',
  excesos: 'movimientos',
};
const emptyLabel = emptyLabels[active] ?? 'datos';

const totalPages = Math.max(meta.totalPages, 1);
const from = meta.totalCount === 0 ? 0 : (meta.page - 1) * meta.limit + 1;
const to = Math.min(meta.page * meta.limit, meta.totalCount);
---
<Base title="Mi cuenta · Portal del Asociado">
  <Topbar />

  <main class="container">
    <h1>Hola, {statement.fullname}</h1>
    <p class="muted">
      Cédula {statement.cedula}
      {statement.accountNumber ? ` · Cuenta ${statement.accountNumber}` : ''}
      {statement.bankName ? ` · ${statement.bankName}` : ''}
    </p>

    <section class="grid cols-3" style="margin-bottom:24px">
      <div class="stat stat--green">
        <div class="stat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2"/><path d="M3 7v10a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2Z"/><path d="M16 12h.01"/></svg>
        </div>
        <div class="label">Total haberes</div>
        <div class="value">{money(statement.totalHaberes)}</div>
      </div>
      <div class="stat stat--blue">
        <div class="stat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h3a1.5 1.5 0 0 1 0 3h-1a1.5 1.5 0 0 0 0 3h3"/></svg>
        </div>
        <div class="label">Disponibilidad (80%)</div>
        <div class="value">{money(statement.disponibility)}</div>
      </div>
      <div class="stat stat--amber">
        <div class="stat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0-9-9"/><path d="M12 12l4-4"/><path d="M12 3v9h9"/></svg>
        </div>
        <div class="label">Capacidad de pago (30%)</div>
        <div class="value">{money(statement.paymentCapacity)}</div>
      </div>
    </section>

    <nav class="tabs">
      {tabs.map((t) => (
        <a href={link(t.value)} class:list={['tab', { active: t.value === active }]}>{t.label}</a>
      ))}
    </nav>

    {active === 'excesos' && (
      <section class="chips">
        {EXCESOS_TYPES.map((t) => (
          <a href={excesosLink(t.value)} class:list={['chip', { active: t.value === selectedType }]}>
            {t.label}
            <span class="chip-count">{counts[t.value] ?? 0}</span>
          </a>
        ))}
      </section>
    )}

    <section>
      {rows.length === 0 ? (
        <EmptyState label={emptyLabel} />
      ) : (
        <>
          <div class="filterbar">
            <input id="rowFilter" type="search" placeholder="Filtrar en la tabla…" />
          </div>
          <table>
            <thead>
              <tr>
                {columns.map((c) => <th>{c.label}</th>)}
                {detailKindForTab && <th></th>}
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  {columns.map((c) => (
                    <td>
                      {c.badge
                        ? <span class:list={['badge', statusTone(r.status)]}>{c.render(r)}</span>
                        : c.render(r)}
                    </td>
                  ))}
                  {detailKindForTab && (
                    <td>
                      <button
                        type="button"
                        class="btn-link js-detail"
                        data-kind={detailKindForTab}
                        data-id={String(r.id)}
                      >
                        Ver
                      </button>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {meta.totalCount > 0 && (
        <div class="pager">
          <span class="pager-info">
            Mostrando {from} a {to} de {meta.totalCount} entradas
          </span>

          <label class="pager-limit">
            <span>Filas por página</span>
            <select id="pageLimit" data-tab={active} data-mt={selectedType}>
              {LIMIT_OPTIONS.map((o) => (
                <option value={o} selected={o === limit}>{o}</option>
              ))}
            </select>
          </label>

          <div class="pager-nav">
            <span class="pager-pages">Páginas {meta.page} de {totalPages}</span>
            <div class="pager-buttons">
              <a
                class:list={['icon-btn', { disabled: meta.page <= 1 }]}
                href={active === 'excesos' ? excesosLink(selectedType, 1) : link(active, 1)}
                aria-label="Primera página"
                title="Primera"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m11 17-5-5 5-5"/><path d="m18 17-5-5 5-5"/></svg>
              </a>
              <a
                class:list={['icon-btn', { disabled: !meta.hasPreviousPage }]}
                href={active === 'excesos' ? excesosLink(selectedType, meta.page - 1) : link(active, meta.page - 1)}
                aria-label="Página anterior"
                title="Anterior"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              </a>
              <a
                class:list={['icon-btn', { disabled: !meta.hasNextPage }]}
                href={active === 'excesos' ? excesosLink(selectedType, meta.page + 1) : link(active, meta.page + 1)}
                aria-label="Página siguiente"
                title="Siguiente"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
              <a
                class:list={['icon-btn', { disabled: meta.page >= totalPages }]}
                href={active === 'excesos' ? excesosLink(selectedType, totalPages) : link(active, totalPages)}
                aria-label="Última página"
                title="Última"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13 17 5-5-5-5"/><path d="m6 17 5-5-5-5"/></svg>
              </a>
            </div>
          </div>
        </div>
      )}
    </section>

    <DetailModal client:load />
  </main>
</Base>

<style>
  .tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 18px;
  }
  .tab { flex: 1 1 0; min-width: 0; text-align: center; padding: 10px 8px; font-size: 0.9rem; color: var(--foreground); opacity: 0.65; font-weight: 600; border-bottom: 2px solid transparent; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tab:hover { opacity: 1; }
  .tab.active { color: var(--primary); opacity: 1; border-bottom-color: var(--primary); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border: 1px solid var(--border); border-radius: 999px;
    background: var(--card); color: var(--foreground); font-weight: 600; font-size: 0.85rem;
  }
  .chip.active { border-color: var(--primary); color: var(--primary); }
  .chip-count { background: var(--primary); color: var(--primary-foreground); border-radius: 999px; padding: 0 8px; font-size: 0.75rem; }
  .filterbar { margin-bottom: 12px; }
  .filterbar input { max-width: 320px; margin-bottom: 0; }
  .pager { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-top: 16px; }
  .pager-info { color: var(--muted-foreground); font-size: 0.9rem; }
  .pager-limit { display: inline-flex; align-items: center; gap: 8px; color: var(--muted-foreground); font-size: 0.9rem; }
  .pager-limit select { width: auto; margin: 0; padding: 6px 10px; }
  .pager-nav { display: inline-flex; align-items: center; gap: 12px; }
  .pager-pages { color: var(--muted-foreground); font-size: 0.9rem; }
  .pager-buttons { display: inline-flex; gap: 6px; }
  .icon-btn { width: 34px; height: 34px; display: inline-grid; place-items: center; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--foreground); }
  .icon-btn svg { width: 16px; height: 16px; }
  .icon-btn.disabled { opacity: 0.4; pointer-events: none; }
  .btn-link { padding: 6px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--foreground); font-weight: 600; display: inline-block; }
  .btn-link.disabled { opacity: 0.5; pointer-events: none; }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  function initFilter() {
    const input = document.getElementById('rowFilter') as HTMLInputElement | null;
    if (!input || input.dataset.bound) return;
    input.dataset.bound = '1';
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      const table = document.querySelector('table');
      table?.querySelectorAll('tbody tr').forEach((tr) => {
        const el = tr as HTMLElement;
        el.style.display = el.textContent?.toLowerCase().includes(q) ? '' : 'none';
      });
    });
  }

  function initLimit() {
    const sel = document.getElementById('pageLimit') as HTMLSelectElement | null;
    if (!sel || sel.dataset.bound) return;
    sel.dataset.bound = '1';
    sel.addEventListener('change', () => {
      const tab = sel.dataset.tab ?? 'haberes';
      const mt = sel.dataset.mt ?? '';
      const params = new URLSearchParams({ tab, page: '1', limit: sel.value });
      if (tab === 'excesos' && mt) params.set('mt', mt);
      void navigate(`/dashboard?${params.toString()}`);
    });
  }

  document.addEventListener('astro:page-load', () => {
    initFilter();
    initLimit();
  });
</script>
