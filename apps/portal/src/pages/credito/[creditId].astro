---
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import { fetchAuthed } from '../../lib/auth';
import { clearSession } from '../../lib/session';
import {
  bsEquivalent,
  creationRate,
  currentRate,
  dateFmt,
  displayCurrency,
  money,
  text,
} from '../../lib/format';
import {
  CREDIT_STATUS_TYPES,
  CURRENCY_TYPES,
  PAYMENT_LOAN_STATUS,
  label,
} from '../../lib/labels';

export const prerender = false;

const { creditId } = Astro.params;

interface ScheduleRow {
  installmentNumber: number;
  dueDate: string;
  principalAmount: string;
  interestAmount: string;
  totalInstallmentAmount: string;
  paymentStatus: string;
  paidAmount: string | null;
}
interface ItemRow {
  itemType: string;
  itemDescription: string | null;
  productName: string | null;
  quantity: number;
  agreedSellingPrice: string;
  saleDate: string | null;
  deliveryStatus: string;
}
interface CreditDetail {
  credit: Record<string, unknown>;
  amortizationSchedule: ScheduleRow[];
  items: ItemRow[];
  summary: {
    totalPaid: number;
    totalPending: number;
    paidInstallments: number;
    pendingInstallments: number;
  };
}

const res = await fetchAuthed(Astro.cookies, `/me/credito/${creditId}`);
if (res.status === 401) {
  clearSession(Astro.cookies);
  return Astro.redirect('/login');
}
const detail = res.data ? ((res.data as { data: CreditDetail }).data ?? null) : null;
const creditCurrency = displayCurrency(
  detail?.credit?.currencyCode,
  detail?.credit?.exchangeRate,
);
const creditCreationRate = creationRate(detail?.credit?.exchangeRate);
const creditCurrentRate = currentRate(
  detail?.credit?.currentExchangeRate,
  detail?.credit?.exchangeRate,
);
const isForeignCredit = creditCurrency !== 'VES';
---
<Base title="Detalle de crédito · Portal del Asociado">
  <Topbar />
  <main class="container">
    <a class="btn-link" href="/dashboard?tab=creditos">← Volver</a>

    {!detail ? (
      <div class="card" style="margin-top:16px"><p class="muted">Crédito no encontrado.</p></div>
    ) : (
      <>
        <h1 style="margin-top:16px">{text(detail.credit.creditTypeName)}</h1>
        <p class="muted">Crédito {text(detail.credit.customReference)} · Estado {label(CREDIT_STATUS_TYPES, detail.credit.status)}</p>

        <section class="grid cols-3" style="margin:18px 0">
          <div class="stat">
            <div class="label">Monto</div>
            <div class="value">{money(detail.credit.requestedAmount, creditCurrency)}</div>
            {isForeignCredit && (
              <div class="cell-sub">≈ {bsEquivalent(detail.credit.requestedAmount, creditCreationRate)} (tasa de creación)</div>
            )}
          </div>
          <div class="stat">
            <div class="label">Saldo pendiente</div>
            <div class="value">{money(detail.summary.totalPending, creditCurrency)}</div>
            {isForeignCredit && (
              <div class="cell-sub">≈ {bsEquivalent(detail.summary.totalPending, creditCurrentRate)} (tasa del día)</div>
            )}
          </div>
          <div class="stat"><div class="label">Total pagado</div><div class="value">{money(detail.summary.totalPaid, creditCurrency)}</div></div>
        </section>

        <section class="grid cols-3" style="margin-bottom:18px">
          <div class="stat">
            <div class="label">Cuota</div>
            <div class="value" style="font-size:1.1rem">{money(detail.credit.installmentAmount, creditCurrency)}</div>
            {isForeignCredit && (
              <div class="cell-sub">≈ {bsEquivalent(detail.credit.installmentAmount, creditCurrentRate)} (tasa del día)</div>
            )}
          </div>
          <div class="stat"><div class="label">Moneda</div><div class="value" style="font-size:1.1rem">{label(CURRENCY_TYPES, creditCurrency)}</div></div>
          <div class="stat"><div class="label">Tasa</div><div class="value" style="font-size:1.1rem">{text(detail.credit.interestRate)}%</div></div>
          <div class="stat"><div class="label">Plazo</div><div class="value" style="font-size:1.1rem">{text(detail.credit.termUnits)} {text(detail.credit.termType)}</div></div>
          <div class="stat"><div class="label">Cuotas pagadas</div><div class="value" style="font-size:1.1rem">{detail.summary.paidInstallments}</div></div>
          <div class="stat"><div class="label">Cuotas pendientes</div><div class="value" style="font-size:1.1rem">{detail.summary.pendingInstallments}</div></div>
          <div class="stat"><div class="label">Pago con haberes</div><div class="value" style="font-size:1.1rem">{money(detail.credit.haberesPayment)}</div></div>
        </section>

        <h2>Plan de amortización</h2>
        <table>
          <thead>
            <tr><th>#</th><th>Vence</th><th>Capital</th><th>Interés</th><th>Cuota</th><th>Pagado</th><th>Estado</th></tr>
          </thead>
          <tbody>
            {detail.amortizationSchedule.map((s) => (
              <tr>
                <td>{s.installmentNumber}</td>
                <td>{dateFmt(s.dueDate)}</td>
                <td>{money(s.principalAmount, creditCurrency)}</td>
                <td>{money(s.interestAmount, creditCurrency)}</td>
                <td>
                  {money(s.totalInstallmentAmount, creditCurrency)}
                  {isForeignCredit && ['PENDING', 'PARTIAL'].includes(s.paymentStatus) && (
                    <div class="cell-sub">≈ {bsEquivalent(s.totalInstallmentAmount, creditCurrentRate)} (tasa del día)</div>
                  )}
                </td>
                <td>{money(s.paidAmount, creditCurrency)}</td>
                <td><span class="badge">{label(PAYMENT_LOAN_STATUS, s.paymentStatus)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>

        {detail.items.length > 0 && (
          <>
            <h2 style="margin-top:24px">Artículos / servicios</h2>
            <table>
              <thead>
                <tr><th>Tipo</th><th>Descripción</th><th>Cant.</th><th>Precio</th><th>Entrega</th></tr>
              </thead>
              <tbody>
                {detail.items.map((i) => (
                  <tr>
                    <td>{text(i.itemType)}</td>
                    <td>{text(i.productName ?? i.itemDescription)}</td>
                    <td>{i.quantity}</td>
                    <td>{money(i.agreedSellingPrice, creditCurrency)}</td>
                    <td>{text(i.deliveryStatus)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}
      </>
    )}
  </main>
  <style>
    .cell-sub { font-size: 0.72rem; color: var(--muted-foreground); margin-top: 2px; }
  </style>
</Base>
