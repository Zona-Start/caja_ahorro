---
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import { fetchAuthed } from '../../lib/auth';
import { clearSession } from '../../lib/session';
import { dateFmt, money, text } from '../../lib/format';

export const prerender = false;

const { creditId } = Astro.params;

interface ScheduleRow {
  installmentNumber: number;
  dueDate: string;
  principalAmount: string;
  interestAmount: string;
  totalInstallmentAmount: string;
  paymentStatus: string;
  paidAmount: string | null;
}
interface ItemRow {
  itemType: string;
  itemDescription: string | null;
  productName: string | null;
  quantity: number;
  agreedSellingPrice: string;
  saleDate: string | null;
  deliveryStatus: string;
}
interface CreditDetail {
  credit: Record<string, unknown>;
  amortizationSchedule: ScheduleRow[];
  items: ItemRow[];
  summary: {
    totalPaid: number;
    totalPending: number;
    paidInstallments: number;
    pendingInstallments: number;
  };
}

const res = await fetchAuthed(Astro.cookies, `/me/credito/${creditId}`);
if (res.status === 401) {
  clearSession(Astro.cookies);
  return Astro.redirect('/login');
}
const detail = res.data ? ((res.data as { data: CreditDetail }).data ?? null) : null;
---
<Base title="Detalle de crédito · Portal del Asociado">
  <Topbar />
  <main class="container">
    <a class="btn-link" href="/dashboard?tab=creditos">← Volver</a>

    {!detail ? (
      <div class="card" style="margin-top:16px"><p class="muted">Crédito no encontrado.</p></div>
    ) : (
      <>
        <h1 style="margin-top:16px">{text(detail.credit.creditTypeName)}</h1>
        <p class="muted">Crédito {text(detail.credit.customReference)} · Estado {text(detail.credit.status)}</p>

        <section class="grid cols-3" style="margin:18px 0">
          <div class="stat"><div class="label">Monto</div><div class="value">{money(detail.credit.requestedAmount)}</div></div>
          <div class="stat"><div class="label">Saldo pendiente</div><div class="value">{money(detail.summary.totalPending)}</div></div>
          <div class="stat"><div class="label">Total pagado</div><div class="value">{money(detail.summary.totalPaid)}</div></div>
        </section>

        <section class="grid cols-3" style="margin-bottom:18px">
          <div class="stat"><div class="label">Cuota</div><div class="value" style="font-size:1.1rem">{money(detail.credit.installmentAmount)}</div></div>
          <div class="stat"><div class="label">Tasa</div><div class="value" style="font-size:1.1rem">{text(detail.credit.interestRate)}%</div></div>
          <div class="stat"><div class="label">Plazo</div><div class="value" style="font-size:1.1rem">{text(detail.credit.termUnits)} {text(detail.credit.termType)}</div></div>
          <div class="stat"><div class="label">Cuotas pagadas</div><div class="value" style="font-size:1.1rem">{detail.summary.paidInstallments}</div></div>
          <div class="stat"><div class="label">Cuotas pendientes</div><div class="value" style="font-size:1.1rem">{detail.summary.pendingInstallments}</div></div>
          <div class="stat"><div class="label">Pago con haberes</div><div class="value" style="font-size:1.1rem">{money(detail.credit.haberesPayment)}</div></div>
        </section>

        <h2>Plan de amortización</h2>
        <table>
          <thead>
            <tr><th>#</th><th>Vence</th><th>Capital</th><th>Interés</th><th>Cuota</th><th>Pagado</th><th>Estado</th></tr>
          </thead>
          <tbody>
            {detail.amortizationSchedule.map((s) => (
              <tr>
                <td>{s.installmentNumber}</td>
                <td>{dateFmt(s.dueDate)}</td>
                <td>{money(s.principalAmount)}</td>
                <td>{money(s.interestAmount)}</td>
                <td>{money(s.totalInstallmentAmount)}</td>
                <td>{money(s.paidAmount)}</td>
                <td><span class="badge">{s.paymentStatus}</span></td>
              </tr>
            ))}
          </tbody>
        </table>

        {detail.items.length > 0 && (
          <>
            <h2 style="margin-top:24px">Artículos / servicios</h2>
            <table>
              <thead>
                <tr><th>Tipo</th><th>Descripción</th><th>Cant.</th><th>Precio</th><th>Entrega</th></tr>
              </thead>
              <tbody>
                {detail.items.map((i) => (
                  <tr>
                    <td>{text(i.itemType)}</td>
                    <td>{text(i.productName ?? i.itemDescription)}</td>
                    <td>{i.quantity}</td>
                    <td>{money(i.agreedSellingPrice)}</td>
                    <td>{text(i.deliveryStatus)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}
      </>
    )}
  </main>
</Base>
