---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle';
import { getSession } from '../lib/session';

const { access, refresh } = getSession(Astro.cookies);
if (access || refresh) return Astro.redirect('/dashboard');

const hasError = Astro.url.searchParams.get('error') === '1';
const tenant = Astro.locals.tenant;
const name = tenant?.name ?? 'Portal del Asociado';
---
<Base title={`Ingresar · ${name}`}>
  <div class="floating-toggle"><ThemeToggle client:load /></div>
  <div class="center">
    <div class="card">
      {tenant?.logoUrl && <img src={tenant.logoUrl} alt={name} class="login-logo" />}
      <h1>{name}</h1>
      <p class="muted">Ingresa con tu cédula para consultar tu estado de cuenta.</p>

      {hasError && (
        <div class="alert">Credenciales inválidas. Verifica tu cédula e intenta de nuevo.</div>
      )}

      <form method="POST" action="/api/login" autocomplete="on">
        <label for="identifier">Cédula</label>
        <input
          id="identifier"
          name="identifier"
          type="text"
          inputmode="numeric"
          placeholder="Ej: 12345678"
          autocomplete="username"
          required
        />

        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="Tu cédula"
          autocomplete="current-password"
          required
        />

        <button type="submit">Iniciar sesión</button>
      </form>
    </div>
  </div>
</Base>
