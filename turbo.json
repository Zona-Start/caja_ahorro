{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": ["API_URL", "VITE_API_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "cache": false,
      "outputLogs": "full"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "dependsOn": ["^start"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"]
    }
  }
}
